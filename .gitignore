# Checkpoints and training states are too large for git (GitHub refuses files over 100 MB).
# They are attached to the GitHub Release instead; fetch them with `bash handoff/fetch_checkpoints.sh`.
*.pt
*.ckpt

# Dataset and caches (download_dataset.py recreates the dataset; the teacher sample cache is in the Release)
data/pokemon-generation-one-22k/PokemonData/
data/pokemon-generation-one-22k/.transparency_composited_on_white
data/cache/

# FID sample folders: regenerated by the scoring scripts
runs/*/fid_samples/
results/*/
results/reference_train_feats.npy
results/reference_train_balanced_features.npz

# Process bookkeeping
runs/*/train.pid
runs/*.lock
runs/*.stop

# Teammate's repository snapshots (they have the source)
FastGen-main*.zip

__pycache__/
*.pyc
